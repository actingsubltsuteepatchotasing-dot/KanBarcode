{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sqlserver.js": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [{ "source": "/", "destination": "/index.html" }]
}
