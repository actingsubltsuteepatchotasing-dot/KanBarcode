# ============================================================
#  KanBarcode — ตัวอย่าง Environment Variables
#  ------------------------------------------------------------
#  คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#
#      cp .env.local.example .env.local
#
#  .env.local ถูก .gitignore ไว้แล้ว จะไม่ถูก commit ขึ้น git
#  ส่วนไฟล์ .env.local.example นี้ตั้งใจให้ commit ขึ้น git
#  (เป็นตัวอย่างเปล่า ๆ ห้ามใส่ค่าจริงลงในไฟล์นี้)
# ============================================================


# ------------------------------------------------------------
#  Supabase — คัดลอกจาก Supabase Dashboard
#  Project Settings → API
# ------------------------------------------------------------

# Project URL — ของโปรเจกต์นี้คือค่าข้างล่าง (ห้ามมี / ปิดท้าย)
NEXT_PUBLIC_SUPABASE_URL=https://mxjdzpfxndspwdlobxha.supabase.co

# anon public key — สตริงยาวขึ้นต้นด้วย eyJ...
#
#  ⚠ ต้องเป็นคีย์ที่ป้ายเขียนว่า  anon   public  เท่านั้น
#    ห้ามใช้ service_role / sb_secret_ เด็ดขาด เพราะข้าม Row Level Security
#    ได้ทั้งหมด (api/config.js ตรวจจับและปฏิเสธให้อยู่แล้ว แต่อย่าเสี่ยง)
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ============================================================
#  ใช้ยังไง
# ------------------------------------------------------------
#  บน Vercel (ตอน deploy จริง)
#    Settings → Environment Variables → เพิ่มสองตัวข้างบน
#    เลือกให้ครบทั้ง Production / Preview / Development
#    แล้ว Redeploy หนึ่งครั้ง
#
#    เว็บนี้เป็น static HTML ไม่มี build step ตัวแปร NEXT_PUBLIC_*
#    จึงไม่ถูกฝังลงหน้าเว็บตอน build เหมือน Next.js — api/config.js
#    เป็นตัวอ่านค่าให้ตอน runtime ผ่าน GET /api/config แทน
#    แต่ยังต้อง Redeploy หลังแก้ตัวแปรอยู่ดี เพราะ Vercel ผูก
#    environment variables ไว้กับ deployment
#
#  ในเครื่องตัวเอง
#    vercel dev            ← อ่าน .env.local ให้อัตโนมัติ มี /api/config ครบ
#    vercel env pull       ← ดึงค่าจาก Vercel ลงมาเป็น .env.local
#
#    ถ้ารัน  npx serve .  เฉย ๆ จะไม่มี /api/config ให้เรียก
#    หน้าเว็บจะขึ้นช่องให้กรอก URL + anon key เอง (เก็บใน localStorage)
#
#  รายละเอียดทั้งหมด → Docs/SUPABASE-SETUP.md ข้อ 5
# ============================================================


# ------------------------------------------------------------
#  หมายเหตุ: การเชื่อมต่อ SQL Server (api/sqlserver.js)
#  ไม่ได้ใช้ environment variables — ผู้ใช้กรอก server / database /
#  user / password เองที่หน้าเว็บ เมนู เอกสาร → เชื่อมต่อ SQL Server
#  จึงไม่ต้องตั้งค่าอะไรเพิ่มตรงนี้
# ------------------------------------------------------------
